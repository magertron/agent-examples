# Copy to .env and fill in. Never commit .env.
MAGERTRON_URL=https://mcp.example.com
MAGERTRON_LLM_PATH=/api/v1/llm/<namespace>/<llm-server>

# Path A: Magertron is the issuer
MAGERTRON_SA_TOKEN=

# Path B: your directory is the issuer
#MAGERTRON_IDP_TOKEN_URL=https://your-tenant.example.com/oauth/token
#MAGERTRON_IDP_CLIENT_ID=
#MAGERTRON_IDP_CLIENT_SECRET=
#MAGERTRON_EXCHANGE_AUDIENCE=https://sts.example.com

# Optional: act for a person
#MAGERTRON_PERSON_TOKEN=
